<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.UserController">
   <top>
      <Label text="JavaFX MVVM User Management Example" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="10.0" top="10.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox spacing="10.0">
         <children>
            <!-- User Input Form -->
            <VBox spacing="5.0" style="-fx-border-color: lightgray; -fx-border-radius: 5; -fx-padding: 10;">
               <children>
                  <Label text="User Information">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <!-- First Name Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="First Name:" />
                        <TextField fx:id="firstNameField" promptText="Enter first name" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Last Name Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Last Name:" />
                        <TextField fx:id="lastNameField" promptText="Enter last name" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Email Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Email:" />
                        <TextField fx:id="emailField" promptText="Enter email" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Birth Date Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Birth date:" />
                        <DatePicker fx:id="birthDatePicker" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Full Name Display -->
                  <Label fx:id="fullNameLabel" text="Full Name: " style="-fx-font-weight: bold; -fx-text-fill: blue;" />
                  
                  <!-- Action Buttons and Sort Controls -->
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="saveButton" text="Save User" onAction="#handleSaveUser" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                        <Button fx:id="clearButton" text="Clear Form" onAction="#handleClearForm" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
                        <Label text="Sort by" />
                        <ComboBox fx:id="sortCriteriaCombo" prefWidth="100.0" promptText="Select..." />
                        <CheckBox fx:id="ascendingCheckBox" text="Ascending" selected="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- User List Display -->
            <VBox spacing="5.0" style="-fx-border-color: lightgray; -fx-border-radius: 5; -fx-padding: 10;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Users List">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="searchField" promptText="Search..." prefWidth="150.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="userCountLabel" text="Total Users: 0" style="-fx-text-fill: gray;" />
                     </children>
                  </HBox>
                  
                  <!-- Users ListView -->
                  <ListView fx:id="studentListView" VBox.vgrow="ALWAYS" />
                  
                  <!-- List Actions -->
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDeleteUser" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
                        <Label text="Tip: Double-click a user to edit" style="-fx-text-fill: gray; -fx-font-size: 10;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <Label text="MVVM Pattern: Model-View-ViewModel with JavaFX Data Binding" style="-fx-text-fill: gray; -fx-font-size: 10;" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>